#!/bin/sh
# Git's executable entry point; all validation and synchronization logic is PowerShell.
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$(git rev-parse --show-toplevel)/scripts/Invoke-AgentGuidanceHook.ps1" -Mode PreCommit
fi
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(git rev-parse --show-toplevel)/scripts/Invoke-AgentGuidanceHook.ps1" -Mode PreCommit
